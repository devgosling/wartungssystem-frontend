# Appwrite connection used by src/lib/appwrite.js. Set these as variables on the Appwrite Site.
# The values below are also the defaults when a variable is not set.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=wskwt
VITE_APPWRITE_FUNCTION_ID=wskwt-function

# Local development only: put a dev key in .env.local. Never commit it or set it on the Site,
# because every VITE_ variable is embedded in the public bundle.
# VITE_APPWRITE_DEV_KEY=
